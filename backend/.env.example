# Backend environment variables
# Copy this file to .env and fill in real values for your deployment.
# DO NOT commit .env files or real secrets to version control.

# PostgreSQL connection string
# For production on Neon (free tier), use the pooled connection string, e.g.:
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/nexlevr?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/nexlevr

# Secret key used to sign JWT access tokens
# Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Server port
# Render and most cloud hosts set this automatically via process.env.PORT.
PORT=3001

# Application environment
NODE_ENV=production

# CORS origin for the deployed frontend
# Set this to your Vercel production URL, e.g.:
# CORS_ORIGIN=https://nexlevr.vercel.app
CORS_ORIGIN=http://localhost:3000
