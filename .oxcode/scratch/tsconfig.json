{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "baseUrl": "..",
    "paths": {
      "@backend/*": ["backend/src/*"]
    },
    "noEmit": true
  },
  "include": ["../backend/src/**/*", "./**/*"]
}
